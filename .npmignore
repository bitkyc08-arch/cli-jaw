# Submodules — not included in npm package
skills_ref/
devlog/

# Dev files
.git/
.gitmodules
.DS_Store
*.db
*.db-shm
*.db-wal
.env
.artifacts/
node_modules/

# Prevent stale legacy dist artifacts
dist/bin/cli-claw.js
dist/bin/cli-claw.js.map

# Native addons are rebuilt/downloaded per install target; never publish a
# locally-built platform binary from dist/.
dist/src/lib/native/*.node

# Prevent nested Vite publicDir/build artifacts
public/public/
public/dist/dist/
