# Public reference submodules — not included in npm package
skills_ref/
officecli/

# Dev files
.git/
.gitmodules
.DS_Store
*.db
*.db-shm
*.db-wal
.env
.artifacts/
node_modules/

# Prevent stale legacy dist artifacts
dist/bin/cli-claw.js
dist/bin/cli-claw.js.map

# Native addons are rebuilt/downloaded per install target; never publish a
# locally-built platform binary from dist/.
dist/src/lib/native/*.node

# Prevent nested Vite publicDir/build artifacts
public/public/
public/dist/dist/

# Private records belong exclusively in the sibling cli-jaw-internal repository.
# Match files, symlinks and directories at any depth, including case variants.
[dD][eE][vV][lL][oO][gG]
[dD][eE][vV][lL][oO][gG][._-]*
[cC][lL][iI]-[jJ][aA][wW]-[iI][nN][tT][eE][rR][nN][aA][lL]
_[pP][lL][aA][nN]
_[fF][iI][nN]
.[jJ][wW][cC]
